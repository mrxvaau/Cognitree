{
  "mcpServers": {
    "claude-code-explorer": {
      "command": "node",
      "args": [
        "mcp-server/dist/src/index.js"
      ],
      "env": {
        "CLAUDE_CODE_SRC_ROOT": "./mcp-server/src",
        "MCP_CACHE_TTL_SECONDS": "300",
        "MCP_MEMORY_FILE": "./mcp-server/CODEBASE.md",
        "MCP_MODEL": "opus"
      }
    }
  }
}