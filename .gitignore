tmp/
temp/
tmp_check/
scratch/
*.tmp
*.temp
*.bak
*.orig

# ─────────────────────────────────────────────
# Cognitree — project-specific
# ─────────────────────────────────────────────
# Runtime session memory (generated by the engine, not source)
.cognitree/

# Standalone JS engine (has its own .git repo — not a submodule)
cognitree_engine/
