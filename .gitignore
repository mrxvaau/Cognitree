# Dependencies
# ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ─────────────────────────────────────────────
# Build output
# ─────────────────────────────────────────────
dist/
out/
build/
.next/
.nuxt/
*.tsbuildinfo

# esbuild / bundler artefacts
*.js.map
*.d.ts.map

# ─────────────────────────────────────────────
# Bun
# ─────────────────────────────────────────────
# bun.lock is intentionally KEPT (reproducible installs)
bun.lockb

# ─────────────────────────────────────────────
# Environment & secrets
# ─────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.pem
*.key
*.crt

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
# Drizzle generated migrations (keep schema source, ignore generated SQL if desired)
# drizzle/          ← commented out: you probably want migrations in git
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ─────────────────────────────────────────────
# Logs & crash dumps
# ─────────────────────────────────────────────
*.log
*.log.*
logs/
debug-logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
crash_stderr*.log
cli_stderr.log
test_stderr.log
exit_trace.log

# ─────────────────────────────────────────────
# Testing & coverage
# ─────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/

# ─────────────────────────────────────────────
# TypeScript
# ─────────────────────────────────────────────
*.tsbuildinfo

# ─────────────────────────────────────────────
# Biome
# ─────────────────────────────────────────────
# (no output files — just ensuring nothing leaks)

# ─────────────────────────────────────────────
# OS files
# ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ─────────────────────────────────────────────
# Editor & IDE
# ─────────────────────────────────────────────
# VSCode — keep extensions.json and tasks.json, ignore personal settings
.vscode/settings.json
.vscode/launch.json
.vscode/*.code-workspace

# JetBrains
.idea/
*.iml
*.iws
*.ipr

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.#*

# ─────────────────────────────────────────────
# Docker (keep Dockerfile, ignore generated artefacts)
# ─────────────────────────────────────────────
.docker/

# ─────────────────────────────────────────────
# Vercel
# ─────────────────────────────────────────────
.vercel/

# ─────────────────────────────────────────────
